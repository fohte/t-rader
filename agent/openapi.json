{
  "openapi": "3.0.0",
  "info": {
    "title": "t-rader-agent internal API",
    "version": "0.0.0"
  },
  "components": {
    "schemas": {
      "SubmitTaskResponse": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          }
        },
        "required": ["task_id"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "nullable": true
            }
          }
        },
        "required": ["error"]
      },
      "SubmitTaskBody": {
        "type": "object",
        "properties": {
          "strategy_id": {
            "type": "string",
            "minLength": 1
          },
          "prompt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["strategy_id", "prompt"]
      },
      "GetTaskResponse": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "result_text": {
            "type": "string"
          },
          "error_kind": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "nullable": true
            }
          }
        },
        "required": ["task_id", "state"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/internal/tasks": {
      "post": {
        "operationId": "submitTask",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitTaskBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task submitted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitTaskResponse"
                }
              }
            }
          },
          "400": {
            "description": "Malformed JSON body",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request body failed validation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Agent did not create a task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/internal/tasks/{taskId}": {
      "get": {
        "operationId": "getTask",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "taskId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Task status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTaskResponse"
                }
              }
            }
          },
          "404": {
            "description": "Task not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure while fetching the task",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
