{
  "name": "agent",
  "private": true,
  "type": "module",
  "imports": {
    "#db": "./src/db/index.ts",
    "#lib/api/schema.gen": "./src/lib/api/schema.gen.js",
    "#*": "./src/*.ts"
  },
  "scripts": {
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "build": "tsup src/index.ts src/db/migrate.ts --format esm --out-dir dist --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "dump-openapi": "tsx src/dump-openapi.ts",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.gen.d.ts && prettier --write src/lib/api/schema.gen.d.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@fohte/service-kit": "0.1.7",
    "@hono/node-server": "2.0.12",
    "@hono/zod-openapi": "1.5.2",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/mcp-adapters": "1.1.3",
    "@langchain/openai": "1.5.5",
    "@opentelemetry/api": "1.9.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "langchain": "1.5.4",
    "neverthrow": "8.2.0",
    "postgres": "3.4.9",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "openapi-typescript": "7.13.0",
    "tsup": "8.5.1",
    "tsx": "4.23.1"
  }
}
