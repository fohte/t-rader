# ローカル開発用のデフォルト環境変数
# 個人の上書きは .env.local に記述する (.env.local は git 管理外)
#
# DATABASE_URL は `mise run db-up` が生成する .env.runtime (git 管理外) で設定される。
# db のホストポートはランダム割り当てのため、ここに静的なデフォルト値は置けない


# t-rader-agent 内部 API client (戦略タスクの投入先)。production では t-rader-agent の internal API base URL を設定する
# 値 "disabled" は dev 用 sentinel で、設定時は agent へのタスク投入を無効化して起動する
TRADER_AGENT_API_URL=disabled

# t-rader-agent からの webhook 通知 (POST /api/agent-tasks/notifications) を認証する bearer token
# agent 側の BACKEND_WEBHOOK_TOKEN と同じ値にすること
AGENT_WEBHOOK_TOKEN=dev-webhook-token
