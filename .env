# ローカル開発用のデフォルト環境変数
# 個人の上書きは .env.local に記述する (.env.local は git 管理外)
#
# DATABASE_URL は `mise run db-up` が生成する .env.runtime (git 管理外) で設定される。
# db のホストポートはランダム割り当てのため、ここに静的なデフォルト値は置けない

# kubeopencode (Task CR) client。production では kube-apiserver の URL を設定する
# 値 "disabled" は dev 用 sentinel で、設定時は kubeopencode を無効化して起動する
KUBEOPENCODE_API_URL=disabled
