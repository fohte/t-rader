{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
    'github>fohte/renovate-config:rust.json5',
  ],

  customManagers: [
    {
      // Track `schemathesis/action`'s `with: version:` as a `schemathesis` PyPI
      // release. The action installs schemathesis via `uv tool install` at
      // runtime and defaults to an unpinned version range, so without this
      // manager a pinned version drifts silently. schemathesis/action is only
      // used in this repo, so this manager lives here instead of the shared
      // renovate-config.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '[ \\t]+(?:- )?uses:[ \\t]+schemathesis/action@\\S+[^\\n]*\\n[ \\t]+with:[ \\t]*\\n(?:[ \\t]+[^-\\s][^\\n]*\\n)*?[ \\t]+version:\\s*(?<currentValue>\\S+)',
      ],
      datasourceTemplate: 'pypi',
      depNameTemplate: 'schemathesis',
    },
  ],

  packageRules: [
    // sea-orm-cli (.mise.toml) は sea-orm/sea-orm-migration の cargo 依存と同じ group
    // にまとまり、group 内の全メンバーに automerge: true が揃うまで group 全体が
    // automerge されない。
    {
      matchManagers: ['mise'],
      matchPackageNames: ['sea-orm-cli'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
