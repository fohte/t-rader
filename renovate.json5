{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>fohte/renovate-config:base.json5',
    'github>fohte/renovate-config:node.json5',
    'github>fohte/renovate-config:rust.json5',
  ],

  customManagers: [
    {
      // schemathesis/action installs schemathesis from PyPI via `with: version:`
      // at runtime, so a pinned version drifts silently without this manager.
      customType: 'regex',
      managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/'],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version:\\s*(?<currentValue>\\S+)',
      ],
    },
  ],

  packageRules: [
    // sea-orm-cli (.mise.toml) は sea-orm/sea-orm-migration の cargo 依存と同じ group
    // にまとまり、group 内の全メンバーに automerge: true が揃うまで group 全体が
    // automerge されない。
    {
      matchManagers: ['mise'],
      matchPackageNames: ['sea-orm-cli'],
      matchUpdateTypes: ['patch'],
      automerge: true,
    },
  ],
}
