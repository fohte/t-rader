# データベース設定
POSTGRES_USER=t_rader
POSTGRES_PASSWORD=t_rader
POSTGRES_DB=t_rader_development

# backend プロセスのリッスンポート (`cargo run` でローカル直接起動する場合や本番で使用。
# docker compose 経由のホスト側ポートはランダム割り当てのため無関係)
BACKEND_PORT=3000

# バックエンド DB 接続 (`cargo run` でローカル直接起動する場合のみ使用)
# db のホストポートはランダム割り当てのため、`mise run db-up` が実ポートを反映した
# DATABASE_URL を .env.runtime (git 管理外) に自動生成する。手動での設定は不要。例:
#   DATABASE_URL=postgres://t_rader:t_rader@localhost:5432/t_rader_development

# DataProvider 選択 (jquants | ibkr | none)
DATA_PROVIDER=jquants

# J-Quants API (DATA_PROVIDER=jquants で使用)
JQUANTS_API_KEY=

# IBKR Client Portal Web API (DATA_PROVIDER=ibkr で使用)
# Client Portal Gateway を別途常駐させ、その URL を指定する
IBKR_BASE_URL=https://localhost:5000/v1/api
# Gateway 側で Bearer 認証が必要な場合のみ設定 (通常は空欄でよい)
IBKR_SESSION_TOKEN=
# 日本株取引所コード (デフォルト: TSEJ)
IBKR_EXCHANGE=TSEJ

# t-rader-agent 内部 API client (戦略タスクの投入先)。production では t-rader-agent の internal API base URL を設定する
# 値 "disabled" は dev 用 sentinel で、設定時は agent へのタスク投入を無効化して起動する
TRADER_AGENT_API_URL=disabled
# agent 側の INTERNAL_API_TOKEN と同じ値を設定すること (TRADER_AGENT_API_URL=disabled の場合は不要)
TRADER_AGENT_API_TOKEN=dev-internal-token

# agent (t-rader-agent) プロセスのリッスンポート (`pnpm dev` でローカル直接起動する場合や本番で使用。
# docker compose 経由のホスト側ポートはランダム割り当てのため無関係)
TRADER_AGENT_PORT=8080

# agent が自身の A2A Agent Card に載せる URL (他エージェントからの疎通先)
TRADER_AGENT_URL=http://localhost:8080/

# agent を `pnpm dev` でローカル直接起動する場合、DATABASE_URL は .env.runtime の backend 用の値ではなく
# agent 専用の論理 DB (t_rader_agent_development) を指す値に .env.local で上書きすること。例 (<port> は
# .env.runtime の DATABASE_URL または `docker compose -f docker-compose.infra.yml port db 5432` で確認):
#   DATABASE_URL=postgres://t_rader:t_rader@localhost:<port>/t_rader_agent_development

# backend -> agent の internal API 呼び出しを認証する bearer token
INTERNAL_API_TOKEN=dev-internal-token

# agent -> backend の push notification (task 状態通知) 送信先と認証 token
BACKEND_WEBHOOK_URL=http://localhost:3000/api/agent-tasks/notifications
BACKEND_WEBHOOK_TOKEN=dev-webhook-token

# backend が agent からの push notification (POST /api/agent-tasks/notifications) を認証する bearer token
# 上の BACKEND_WEBHOOK_TOKEN と同じ値を設定すること
AGENT_WEBHOOK_TOKEN=dev-webhook-token

# agent が戦略の AGENTS.md / skills / model を取得する backend のベース URL
BACKEND_API_BASE_URL=http://localhost:3000

# agent が strategy tool 群に接続する backend の MCP エンドポイント
STRATEGY_MCP_URL=http://localhost:3000/mcp/strategy

# agent が strategy_id metadata の無い message から対象戦略を名前解決する際に使う backend の管理 MCP エンドポイント
MGMT_MCP_URL=http://localhost:3000/mcp/mgmt

# agent が戦略 Agent の LLM (OpenCode Go) 呼び出しに使う API キー。設定しないと agent の起動に失敗する。
# docker-compose の agent サービスは .env を読み込まないため、.env.local に設定すること
OPENCODE_API_KEY=

# agent が戦略 Agent の LLM 呼び出しに使う OpenAI 互換エンドポイントの base URL。
# 未設定時は OpenCode Go のエンドポイントにフォールバックする
OPENCODE_BASE_URL=
