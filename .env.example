# backend プロセスのリッスンポート (`cargo run -p backend` でローカル直接起動する場合や本番で使用。
# docker compose 経由のホスト側ポートはランダム割り当てのため無関係)
BACKEND_PORT=3000

# reverse proxy header 認証 (両方空欄なら loopback のみで認証なし)
GRAPHILE_WORKER_ADMIN_UI_AUTH_HEADER_NAME=
GRAPHILE_WORKER_ADMIN_UI_AUTH_HEADER_VALUE=

# backend と agent の DATABASE_URL / TEST_DATABASE_URL は各 package の .mise.toml が設定する。

# DataProvider 選択 (jquants | ibkr | none)
DATA_PROVIDER=jquants

# J-Quants API (DATA_PROVIDER=jquants で使用)
JQUANTS_API_KEY=
# API キーを設定する場合、provider の選択にかかわらず実際の契約プランを指定する
# (free | light | standard | premium)
JQUANTS_PLAN=

# IBKR Client Portal Web API (DATA_PROVIDER=ibkr で使用)
# Client Portal Gateway を別途常駐させ、その URL を指定する
IBKR_BASE_URL=https://localhost:5000/v1/api
# Gateway 側で Bearer 認証が必要な場合のみ設定 (通常は空欄でよい)
IBKR_SESSION_TOKEN=
# 日本株取引所コード (デフォルト: TSEJ)
IBKR_EXCHANGE=TSEJ

# FRED (Federal Reserve Economic Data) API (マクロ指標履歴の取り込みに使用。
# 未設定なら取り込み poll task は起動しない)
FRED_API_KEY=

# Firecrawl API (未設定ならニュース本文取得 job は起動しない)
FIRECRAWL_API_KEY=

# Alpha Vantage API (米国株の決算予定の取り込みに使用。未設定なら取り込み job は登録されない)
ALPHA_VANTAGE_API_KEY=

# SEC company tickers exchange list (米国株マスタ同期に使用。連絡先を含む User-Agent を指定する)
# 未設定なら米国株マスタ同期 job は登録されない
SEC_USER_AGENT=

# t-rader-agent 内部 API client (戦略タスクの投入先)。production では t-rader-agent の internal API base URL を設定する
# 値 "disabled" は dev 用 sentinel で、設定時は agent へのタスク投入を無効化して起動する
TRADER_AGENT_API_URL=disabled
# agent 側の INTERNAL_API_TOKEN と同じ値を設定すること (TRADER_AGENT_API_URL=disabled の場合は不要)
TRADER_AGENT_API_TOKEN=dev-internal-token

# agent (t-rader-agent) プロセスのリッスンポート (`pnpm dev` でローカル直接起動する場合や本番で使用。
# docker compose 経由のホスト側ポートはランダム割り当てのため無関係)
TRADER_AGENT_PORT=8080

# agent が自身の A2A Agent Card に載せる URL (他エージェントからの疎通先)
TRADER_AGENT_URL=http://localhost:8080/

# agent の DATABASE_URL / TEST_DATABASE_URL は agent/.mise.toml が設定する。

# backend -> agent の internal API 呼び出しを認証する bearer token
INTERNAL_API_TOKEN=dev-internal-token

# agent -> backend の push notification (task 状態通知) 認証 token
BACKEND_WEBHOOK_TOKEN=dev-webhook-token

# backend が agent からの push notification (POST /api/agent-tasks/notifications) を認証する bearer token
# 上の BACKEND_WEBHOOK_TOKEN と同じ値を設定すること
AGENT_WEBHOOK_TOKEN=dev-webhook-token

# agent が backend API、webhook、MCP endpoint に接続する base URL
BACKEND_API_BASE_URL=http://localhost:3000

# agent が戦略 Agent の LLM 呼び出しに使う API キー (LLM_BASE_URL を差し替えた場合はその接続先の API キー)。
# 設定しないと agent の起動に失敗する。docker-compose の agent サービスは .env を読み込まないため、.env.local に設定すること
# backend もモデル選択肢 API (GET /api/agent-models) で LiteLLM Proxy を叩く際にこの値を使う
LLM_API_KEY=

# agent が戦略 Agent の LLM 呼び出しに使う OpenAI 互換エンドポイントの base URL。
# 未設定時は OpenCode Go のエンドポイントにフォールバックする
# backend は LiteLLM Proxy を指している場合のみモデル選択肢を取得できる。未設定、または
# LiteLLM 以外のエンドポイントを指している場合は GET /api/agent-models が空配列を返す
LLM_BASE_URL=
