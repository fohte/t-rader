# データベース設定
POSTGRES_USER=t_rader
POSTGRES_PASSWORD=t_rader
POSTGRES_DB=t_rader_development

# ポート設定
DB_PORT=5432
# worktree ごとに衝突しないよう変更すること (例: 2 つ目の worktree では 3001, 5174)
BACKEND_PORT=3000
FRONTEND_PORT=5173

# バックエンド DB 接続 (ローカル開発用)
DATABASE_URL=postgres://t_rader:t_rader@localhost:5432/t_rader_development

# DataProvider 選択 (jquants | ibkr | none)
DATA_PROVIDER=jquants

# J-Quants API (DATA_PROVIDER=jquants で使用)
JQUANTS_API_KEY=

# IBKR Client Portal Web API (DATA_PROVIDER=ibkr で使用)
# Client Portal Gateway を別途常駐させ、その URL を指定する
IBKR_BASE_URL=https://localhost:5000/v1/api
# Gateway 側で Bearer 認証が必要な場合のみ設定 (通常は空欄でよい)
IBKR_SESSION_TOKEN=
# 日本株取引所コード (デフォルト: TSEJ)
IBKR_EXCHANGE=TSEJ

# kubeopencode (Task CR) client。production では kube-apiserver の URL を設定する
# 値 "disabled" は dev 用 sentinel で、設定時は kubeopencode を無効化して起動する
KUBEOPENCODE_API_URL=disabled
