{
  "name": "frontend",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "tsr generate && conc pnpm:test:type:only pnpm:test:unit",
    "test:type": "tsr generate && pnpm test:type:only",
    "test:type:only": "tsc --noEmit",
    "test:unit": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.gen.d.ts && prettier --write src/lib/api/schema.gen.d.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@eslint/eslintrc": "3.3.6",
    "@fohte/eslint-config": "0.4.0",
    "@storybook/addon-docs": "10.2.10",
    "@storybook/addon-themes": "10.2.10",
    "@storybook/react-vite": "10.2.10",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@tsconfig/node-lts": "24.0.0",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "25.2.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "10.0.4",
    "eslint": "10.6.0",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "shadcn": "3.8.5",
    "storybook": "10.2.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "@ninoseki/eslint-plugin-neverthrow": "0.2.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.0",
    "lucide-react": "0.577.0",
    "neverthrow": "8.2.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.2",
    "tailwind-merge": "3.6.0"
  },
  "imports": {
    "#*.css": "./src/*.css",
    "#*": "./src/*.js"
  }
}
