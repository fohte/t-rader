{
  "name": "frontend",
  "private": true,
  "type": "module",
  "imports": {
    "#*.css": "./src/*.css",
    "#storybook/story-router": "./.storybook/story-router.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "pnpm run generate:routes && tsc --noEmit",
    "test:unit": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "storybook:screenshot": "vitest run --config vitest.screenshot.config.ts",
    "generate:api": "openapi-typescript ../backend/openapi.json -o src/lib/api/schema.gen.d.ts && prettier --write src/lib/api/schema.gen.d.ts",
    "generate:routes": "tsr generate"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.0",
    "@monaco-editor/react": "4.7.0",
    "@tanstack/react-query": "5.90.21",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@xyflow/react": "12.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lightweight-charts": "5.2.0",
    "lucide-react": "0.577.0",
    "mdast-util-find-and-replace": "3.0.2",
    "monaco-editor": "0.56.0",
    "neverthrow": "8.2.0",
    "openapi-fetch": "0.17.0",
    "openapi-react-query": "0.5.4",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.2",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.16.2",
    "tailwind-merge": "3.6.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@fohte/storybook-addon": "0.1.3",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@storycap-testrun/browser": "2.1.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query-devtools": "5.91.3",
    "@tanstack/router-cli": "1.167.21",
    "@tanstack/router-plugin": "1.168.23",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/browser": "4.1.10",
    "@vitest/browser-playwright": "4.1.10",
    "jsdom": "28.1.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.62.1",
    "storybook": "10.4.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.2.1"
  }
}
